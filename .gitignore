.maestro/
.sprint/
BRIEF.md

# Quarantine holds raw, un-scrubbed blocks (may contain plaintext secrets) and
# logs — never commit their contents. Keep the dir markers only. (REVIEW.md #14)
hub/quarantine/*
!hub/quarantine/.gitkeep
hub/logs/*
!hub/logs/.gitkeep

# Daily digest artifacts (REVIEW.md #15) are a local report surface (may
# quote masked scrub-warning hits) regenerated every merge run, not brain
# content -- never commit them.
hub/digest-*.md

# The merge's liveness stamp, rewritten on every completed run. Local state, not
# brain content; tracking it would leave the tree dirty every night and trip
# loreport-sync's post-merge safety guard.
hub/merge-state.json

# Generated by make-surface.sh — a rebuildable concatenation of PROFILE + INDEX
# (and with --all it contains `local` items). Never commit it.
surface.md

# Python bytecode from importing hub modules in tests
__pycache__/
*.pyc

# Runtime lock taken by inbox_ingest.py / brain_merge.py. Never tracked.
hub/.loreport.lock
