#!/usr/bin/env bash
# Loreport health check — consumer of last resort (design-08).
# Read-only checks; set -uo pipefail without -e so every check runs.
set -uo pipefail

usage() {
  cat <<'USAGE'
usage: loreport-health [--config PATH] [--pasted]

  --config PATH   instance config (default: ./loreport.conf)
  --pasted        record that hub/surface-chatgpt.md was pasted, then exit
  -h, --help      this message

Required config keys: LOREPORT_BRAIN, LOREPORT_ENGINE
Optional:             LOREPORT_NOTIFY, LOREPORT_BANNER,
                      LOREPORT_MERGE_MAX_AGE_HOURS (default 36)

Exit codes: 0 = healthy (items may be pending review — that is not a failure),
            1 = unhealthy and already reported, 2 = the check could not start.
USAGE
}

CONFIG="./loreport.conf"
DO_PASTED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --pasted) DO_PASTED=1; shift ;;
    --config) CONFIG="${2:-}"; shift 2 || true ;;
    --config=*) CONFIG="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "loreport-health: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# A missing config is fatal, not a fallback. This check's whole job is to be the
# consumer of last resort, so the one thing it must never do is run against a
# guessed brain and report it healthy. The previous version defaulted BRAIN to
# $PWD; under systemd that is $HOME, where every path below silently resolves to
# nothing. Refusing to start is loud, and loud is the point.
if [ ! -r "$CONFIG" ]; then
  echo "loreport-health: config not found or unreadable: $CONFIG" >&2
  echo "loreport-health: pass --config PATH, or run from a brain containing loreport.conf" >&2
  exit 2
fi

# shellcheck source=/dev/null
. "$CONFIG"

# BRAIN and FRAMEWORK get no defaults for the same reason: a wrong-but-plausible
# value here IS the silent-green failure. :? aborts on unset or empty, which
# matters because this script runs without -e and would otherwise sail past.
BRAIN="${LOREPORT_BRAIN:?loreport-health: LOREPORT_BRAIN not set in $CONFIG}"
FRAMEWORK="${LOREPORT_ENGINE:?loreport-health: LOREPORT_ENGINE not set in $CONFIG}"
# These two do have honest defaults — a banner in the standard location, and no
# notifier at all. Neither can fake a healthy brain.
BANNER="${LOREPORT_BANNER:-${HOME}/.config/loreport/health-report}"
TG_NOTIFY="${LOREPORT_NOTIFY:-}"
# Freshness budget for the nightly merge. 36h, not 24h: the merge runs once a
# night, so a 24h budget goes red on any single late run, a reboot, or a DST
# shift, and a check that cries wolf gets muted. 36h still catches "it did not
# run last night" by the following evening.
MERGE_MAX_AGE_HOURS="${LOREPORT_MERGE_MAX_AGE_HOURS:-36}"

for d in "$BRAIN" "$FRAMEWORK"; do
  [ -d "$d" ] || { echo "loreport-health: not a directory: $d (check $CONFIG)" >&2; exit 2; }
done

HEALTH_STATE="${BRAIN}/hub/health-state.json"
MANIFEST="${BRAIN}/hub/projection-manifest.json"
MERGE_STATE="${BRAIN}/hub/merge-state.json"
NOW=$(date +%s)

# Three states, not one. This check used to collapse "the merge blew up",
# "nothing has merged in days" and "two files are parked for you to look at"
# into a single line reading `Loreport health FAIL: merge digest needs review`.
# On 2026-08-10 two separate readers took that to mean the merge had failed and
# reported the brain as stuck for three days; it had merged and published every
# night. Failures and pending-review items are therefore kept in separate lists,
# rendered separately, worded separately, and only failures set the exit code.
failures=()
fixes=()
reviews=()
review_fixes=()

# BROKEN or STALE: something is not working. Sets the banner, the FAIL notice
# and exit 1.
note_failure() {
  failures+=("$1")
  fixes+=("$2")
}

# NEEDS REVIEW: the pipeline is healthy and nothing is blocked; a human owes it
# a decision. Never sets the exit code, and its wording must say so — a reader
# who sees this must not be able to mistake it for a merge that failed.
note_review() {
  reviews+=("$1")
  review_fixes+=("$2")
}

tg_notify() {
  local msg="$1"
  shift || true
  [ -x "$TG_NOTIFY" ] && "$TG_NOTIFY" "$msg" "$@" >/dev/null 2>&1 || true
}

index_item_count() {
  # `grep -c` prints 0 AND exits 1 when it matches nothing, so the old
  # `|| echo 0` emitted the string "0\n0" on an empty INDEX — which then blew up
  # the baseline writer with a ValueError and left check 5 crashed but silent
  # (this script runs without -e). Capture, then substitute only on failure.
  local n
  n=$(grep -c '\[\[[^]]\+\]\]' "$BRAIN/INDEX.md" 2>/dev/null) || n=0
  printf '%s' "${n:-0}"
}

json_get() {
  json_get_from "$HEALTH_STATE" "$1"
}

json_get_from() {
  python3 - "$1" "$2" <<'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    print("")
    raise SystemExit(0)
cur = data
for part in key.split("."):
    if not isinstance(cur, dict) or part not in cur:
        print("")
        raise SystemExit(0)
    cur = cur[part]
print(cur if cur is not None else "")
PY
}

json_set_pasted() {
  local surface="$BRAIN/hub/surface-chatgpt.md"
  python3 - "$HEALTH_STATE" "$surface" <<'PY'
import hashlib, json, os, sys, time

state_path, surface_path = sys.argv[1], sys.argv[2]
begin = "<!-- loreport:begin -->"
end = "<!-- loreport:end -->"
try:
    with open(surface_path, encoding="utf-8") as fh:
        text = fh.read()
except OSError:
    print("error: cannot read surface", file=sys.stderr)
    raise SystemExit(1)
if begin in text and end in text:
    _, rest = text.split(begin, 1)
    inner, _ = rest.split(end, 1)
    payload = inner.strip("\n") + "\n"
else:
    payload = text
digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
try:
    with open(state_path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    data = {}
data["chatgpt_pasted"] = {
    "region_hash": f"sha256:{digest}",
    "recorded_epoch": int(time.time()),
}
os.makedirs(os.path.dirname(state_path), exist_ok=True)
with open(state_path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\n")
print(f"recorded ChatGPT paste hash sha256:{digest}")
PY
}

region_hash_file() {
  local path="$1" mode="$2"
  python3 - "$path" "$mode" "$FRAMEWORK/hub" <<'PY'
import sys
sys.path.insert(0, sys.argv[3])
from project import region_hash
path, mode = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    text = fh.read()
print(region_hash(text, mode))
PY
}

if [ "$DO_PASTED" -eq 1 ]; then
  json_set_pasted
  exit 0
fi

# --- 1. Sync ran recently ----------------------------------------------------
last_main_ct=$(git -C "$BRAIN" log -1 --format=%ct main 2>/dev/null || echo 0)
if [ "$last_main_ct" -eq 0 ] || [ $((NOW - last_main_ct)) -gt $((48 * 3600)) ]; then
  note_failure "brain sync stale ≥2 days" "run or inspect loreport-brain-sync.service / sync.sh"
fi

# --- 2. Sync succeeded -------------------------------------------------------
sync_result=$(systemctl --user show loreport-brain-sync.service -p Result --value 2>/dev/null || echo unknown)
if [ "$sync_result" != "success" ]; then
  note_failure "last sync FAILED" "journalctl --user -u loreport-brain-sync.service -n 80"
fi

# --- 3–4. Projection fresh + no hand-edits -----------------------------------
main_sha=$(git -C "$BRAIN" rev-parse main 2>/dev/null || echo "")
if [ -f "$MANIFEST" ] && [ -n "$main_sha" ]; then
  # Capture first, loop after: `python3 ... | while` would run the loop in a subshell
  # and every note_failure inside it would be discarded when the subshell exits.
  projection_out=$(python3 - "$MANIFEST" "$BRAIN" "$main_sha" "$FRAMEWORK/hub" <<'PY'
import json, os, sys
sys.path.insert(0, sys.argv[4])
from project import region_hash, resolve_target_path

manifest_path, brain, main_sha, _ = sys.argv[1:5]
with open(manifest_path, encoding="utf-8") as fh:
    manifest = json.load(fh)
for entry in manifest.get("targets", []):
    rel = entry.get("path", "")
    mode = entry.get("mode", "block")
    path = resolve_target_path(brain, rel)
    label = entry.get("provider") or rel
    if not os.path.isfile(path):
        print(f"stale\tprojection stale/missing: {label}\tproject.py live run or inspect permissions on {rel}")
        continue
    mtime = os.path.getmtime(path)
    recorded = entry.get("mtime")
    if recorded is not None and mtime + 1 < float(recorded):
        print(f"stale\tprojection stale/missing: {label}\tre-run projection after editing {rel}")
    if entry.get("sha") != main_sha:
        print(f"stale\tprojection stale/missing: {label}\twait for nightly sync or run hub/project.py")
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    current = region_hash(text, mode)
    if entry.get("region_hash") and current != entry["region_hash"]:
        print(f"edit\thand-edit inside generated region: {label} — edits will be lost tonight\trevert hand-edits in {rel} or accept overwrite tonight")
    dropped = entry.get("dropped_budget") or 0
    if dropped:
        print(f"trunc\tindex truncation: {label} silently dropped {dropped} line(s)\traise budget_chars for {label} in hub/projection-targets.json or prune index")
PY
)
  while IFS=$'\t' read -r kind target fix; do
    [ -n "${kind:-}" ] || continue
    case "$kind" in
      stale|edit|trunc) note_failure "$target" "$fix" ;;
    esac
  done <<< "$projection_out"
elif [ ! -f "$MANIFEST" ]; then
  note_failure "projection manifest missing" "run hub/project.py once projection is activated"
fi

# --- 5. Capture alive (14-day INDEX count) -----------------------------------
count_now=$(index_item_count)
baseline_count=$(json_get "index_count_baseline.count")
baseline_epoch=$(json_get "index_count_baseline.recorded_epoch")
# Alarm only once the baseline is genuinely 14 days old AND the count has not moved;
# then re-baseline. A fresh (or missing) baseline is recorded silently — comparing a
# 7-day-old baseline would cry "dead for 14 days" after a single quiet week.
if [ -n "$baseline_epoch" ] && [ $((NOW - baseline_epoch)) -ge $((14 * 86400)) ] \
   && [ -n "$baseline_count" ] && [ "$count_now" -eq "$baseline_count" ]; then
  note_failure "no new memories in 14 days — capture is dead again" "capture via Loreport MCP or emit-blocks; check provider branches"
fi
if [ -z "$baseline_epoch" ] || [ $((NOW - baseline_epoch)) -ge $((14 * 86400)) ]; then
  python3 - "$HEALTH_STATE" "$count_now" "$NOW" <<'PY'
import json, os, sys
state_path, count, now = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
try:
    with open(state_path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    data = {}
data["index_count_baseline"] = {"count": count, "recorded_epoch": now}
os.makedirs(os.path.dirname(state_path), exist_ok=True)
with open(state_path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
fi

# --- 5b. Per-provider capture alive ------------------------------------------
# NOT `git log -1 provider/<p>`: brain_merge.py fast-forwards every provider branch to
# main after each merge, so all four branch tips share main's timestamp and that check
# can never fire. The durable per-provider signal is the items themselves — each carries
# `source:` (the capturing host) and `captured:` (the date) in its frontmatter.
# A provider with zero captures ever is "not onboarded", not "dying", so it is skipped.
provider_out=$(python3 - "$BRAIN" "$NOW" <<'PY'
import os, re, sys, time

brain, now = sys.argv[1], int(sys.argv[2])
# source: value -> provider branch it belongs to
SOURCE_MAP = {
    "claude": "claude", "claude-code": "claude", "claude.ai": "claude",
    "codex": "codex",
    "openclaw": "openclaw", "clawdia": "openclaw",
    "chatgpt": "chatgpt",
}
newest = {}
for sub in ("memories", "knowledge"):
    d = os.path.join(brain, sub)
    if not os.path.isdir(d):
        continue
    for fn in os.listdir(d):
        if not fn.endswith(".md"):
            continue
        src = cap = None
        try:
            with open(os.path.join(d, fn), encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith("---") and src is not None:
                        break
                    m = re.match(r"^source:\s*(\S+)", line)
                    if m:
                        src = m.group(1).strip().lower()
                    m = re.match(r"^captured:\s*(\d{4}-\d{2}-\d{2})", line)
                    if m:
                        cap = m.group(1)
        except OSError:
            continue
        prov = SOURCE_MAP.get(src or "")
        if prov and cap:
            newest[prov] = max(newest.get(prov, ""), cap)

for prov, cap in sorted(newest.items()):
    age_days = (now - time.mktime(time.strptime(cap, "%Y-%m-%d"))) / 86400
    if age_days > 30:
        print(f"provider/{prov} silent 30+ days\tlast capture {cap} — check the {prov} capture path (MCP connector / emit-blocks)")
PY
)
while IFS=$'\t' read -r target fix; do
  [ -n "${target:-}" ] || continue
  note_failure "$target" "$fix"
done <<< "$provider_out"

# --- 6. Merge liveness (STALE) -----------------------------------------------
# Nothing used to assert that the merge had actually run. Check #1 looks at the
# age of main's last commit, which only moves when content changes — a brain
# where the merge died on a quiet week still looks fine — and check #6b below
# grades the newest hub/digest-*.md without ever asking how old it is, so a
# merge that stopped a month ago kept being graded on its last good day.
# hub/merge-state.json is written by brain_merge.py on exactly one path: a run
# that completed. Its age is therefore the honest liveness signal.
merge_last_success=$(json_get_from "$MERGE_STATE" "last_success_epoch")
if [ ! -f "$MERGE_STATE" ] || [ -z "$merge_last_success" ]; then
  # Distinct from "old": nothing has ever recorded a completed merge here. On a
  # brain that just took this engine version it clears on the first nightly run.
  note_failure "merge liveness: no completed merge on record (hub/merge-state.json absent or unreadable)" \
    "run the merge once — python3 hub/brain_merge.py --brain-dir $BRAIN — then re-check"
else
  merge_age_h=$(( (NOW - merge_last_success) / 3600 ))
  if [ "$merge_age_h" -ge "$MERGE_MAX_AGE_HOURS" ]; then
    note_failure "merge liveness: last completed merge ${merge_age_h}h ago, budget ${MERGE_MAX_AGE_HOURS}h — the nightly merge is not running" \
      "journalctl --user -u loreport-brain-sync.service -n 80; the merge aborts do not stamp hub/merge-state.json"
  fi
fi

# --- 6b. Merge outcome: what the last completed merge left behind -------------
# Three independent conditions, deliberately no longer an elif chain: they can
# hold at once, they belong to different subsystems, and reporting only the
# first hid the other two. Each message names its subsystem and what actually
# happened, so none of them can be read as "the merge failed" unless it did.
latest_digest=$(ls -1 "$BRAIN"/hub/digest-*.md 2>/dev/null | sort | tail -1 || true)
if [ -n "$latest_digest" ] && [ -f "$latest_digest" ]; then
  # BROKEN. A fail-closed scrub hit rolls main back and merges nothing; the
  # packet providers are served is whatever last succeeded.
  if grep -qiE 'secret-scrub: (FAIL|ABORT)' "$latest_digest"; then
    note_failure "secret-scrub: merge ABORTED — a shared item, PROFILE or skill contains a secret, so nothing merged" \
      "inspect $latest_digest, remove or mark the item visibility: local, then re-run the merge"
  fi

  # NEEDS REVIEW. Quarantined blocks are parked copies; main kept its own
  # version and the merge went on to publish. Nothing is blocked by them, and
  # the count never falls on its own, so this must not be a failure — it would
  # be a permanently-red check, which is a check nobody reads.
  q_line=$(grep -iE 'quarantine items pending review: [0-9]+' "$latest_digest" | tail -1 || true)
  q_count=$(printf '%s' "${q_line:-}" | grep -oE '[0-9]+$' || true)
  if [ -n "${q_count:-}" ] && [ "$q_count" -gt 0 ]; then
    note_review "merge quarantine: ${q_count} block(s) awaiting your decision — the merge and publish completed normally" \
      "review hub/quarantine/ (listed in $latest_digest); delete or re-file each block"
  fi

  # NEEDS REVIEW. An identity conflict is resolved --ours and flagged; the merge
  # completed either way.
  if ! grep -qi 'PROFILE conflicts (human review required): none' "$latest_digest"; then
    note_review "PROFILE conflict: two providers edited identity, main's version was kept and flagged — the merge and publish completed normally" \
      "compare the flagged files named in $latest_digest and pick the correct PROFILE.md content"
  fi
fi

# --- 6b. Synthesis detector health (design-wiki-parity §2) --------------------
# "If the cluster detector emits degenerate output (single-token topics — the REM
# failure), alarm." The detector itself refuses such topics and reports them as
# warnings instead of proposals; this is the consumer that makes those warnings
# visible, so the calibration window is tuned on something a human actually reads.
SYNTH_REPORT="$BRAIN/hub/synthesis-report.json"
if [ -f "$SYNTH_REPORT" ]; then
  synth_out=$(python3 - "$SYNTH_REPORT" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError) as e:
    print(f"synth\tsynthesis report unreadable: {e}\tcheck hub/synthesis-report.json or re-run hub/brain_merge.py")
    raise SystemExit(0)
if data.get("error"):
    print(f"synth\tsynthesis detector errored: {data['error']}\tsee hub/synth_detect.py")
warnings = data.get("warnings") or []
degenerate = [w for w in warnings if w.get("reason") == "degenerate-topic"]
oversized = [w for w in warnings if w.get("reason") == "oversized-cluster"]
if degenerate:
    topics = ", ".join(sorted({w.get("topic", "?") for w in degenerate})[:5])
    print(f"synth\tsynthesis detector emitting degenerate topics ({len(degenerate)}): {topics}\tthe REM failure mode — retune the signal in hub/synth_detect.py before arming synthesis")
if oversized:
    print(f"synth\tsynthesis detector emitting oversized clusters ({len(oversized)})\tlink-graph sprawl, not a topic — tighten clustering before arming synthesis")
PY
)
  while IFS=$'\t' read -r kind target fix; do
    [ -n "${kind:-}" ] || continue
    [ "$kind" = "synth" ] && note_failure "$target" "$fix"
  done <<< "$synth_out"
fi

# --- 7. ChatGPT surface staleness ---------------------------------------------
# Review, not failure: the pipeline produced a correct new surface, and the only
# outstanding action is a human pasting it, since ChatGPT has no write path.
# Grading it as a failure made every genuinely broken run arrive in a mailbox
# that was already red.
#
# The old 30-day nag throttle is GONE, and its removal is load-bearing. It gated
# whether the item entered the list at all, so it gated the state as well: week 0
# reported `review`, week 1 the throttle suppressed the item, the state fell back
# to `ok`, the banner was deleted — and once recovery announcements existed, the
# check would cheerfully report "all checks green" while the surface was still
# unpasted, on a 30-day loop. Throttling belongs to the state-change gate below,
# which is one throttle; two stacked ones oscillate.
chatgpt_surface="$BRAIN/hub/surface-chatgpt.md"
pasted_hash=$(json_get "chatgpt_pasted.region_hash")
if [ -f "$chatgpt_surface" ] && [ -n "$pasted_hash" ]; then
  current_hash=$(region_hash_file "$chatgpt_surface" block)
  if [ "$current_hash" != "$pasted_hash" ]; then
    note_review "ChatGPT surface: regenerated since your last paste — nothing is broken, ChatGPT is just serving older content" \
      "re-paste hub/surface-chatgpt.md into ChatGPT, then run: loreport-health --pasted --config $CONFIG"
  fi
fi

# --- outcome -----------------------------------------------------------------
# One of exactly three states. `review` is a healthy state: it exits 0, it keeps
# the weekly heartbeat alive, and its notice never contains the word FAIL.
if [ "${#failures[@]}" -gt 0 ]; then
  state="failing"
elif [ "${#reviews[@]}" -gt 0 ]; then
  state="review"
else
  state="ok"
fi

if [ "$state" != "ok" ]; then
  mkdir -p "$(dirname "$BANNER")"
  {
    echo "=== Loreport health ($(date '+%Y-%m-%d %H:%M %Z')) ==="
    echo
    if [ "${#failures[@]}" -gt 0 ]; then
      echo "FAILING — these are broken or stale:"
      echo
      for i in "${!failures[@]}"; do
        echo "✗ ${failures[$i]}"
        echo "  fix: ${fixes[$i]}"
        echo
      done
    fi
    if [ "${#reviews[@]}" -gt 0 ]; then
      echo "NEEDS REVIEW — the pipeline is healthy and nothing is blocked;"
      echo "these are waiting on a decision from you:"
      echo
      for i in "${!reviews[@]}"; do
        echo "⧗ ${reviews[$i]}"
        echo "  next: ${review_fixes[$i]}"
        echo
      done
    fi
    echo "When nothing is failing or pending, this file is removed automatically."
  } >"$BANNER"
else
  rm -f "$BANNER"
fi

# Alert on state CHANGE, not on every run. A weekly timer that re-sends the same
# line indefinitely trains the reader to ignore it, and a quarantine count never
# falls without a human, so an unchanged "needs review" would repeat forever.
# The signature covers the message set as well as the state, so a NEW failure
# arriving while an old one is unresolved still speaks up.
liveness_changed=$(python3 - "$HEALTH_STATE" "$state" "$NOW" \
  ${failures[@]+"${failures[@]}"} ${reviews[@]+"${reviews[@]}"} <<'PY'
import hashlib, json, os, sys

state_path, state, now = sys.argv[1], sys.argv[2], int(sys.argv[3])
messages = sys.argv[4:]
signature = "sha256:" + hashlib.sha256("\n".join(messages).encode("utf-8")).hexdigest()
try:
    with open(state_path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    data = {}
previous = data.get("liveness") or {}
changed = previous.get("state") != state or previous.get("signature") != signature
# "changed" alone would make a brand-new brain's FIRST run announce a recovery
# from a state it was never in. Recovery is only meaningful against a recorded
# prior state, so it is reported separately from mere change.
recovered = changed and state == "ok" and previous.get("state") in ("failing", "review")
print("recovered" if recovered else ("changed" if changed else "same"))
if changed:
    data["liveness"] = {"state": state, "signature": signature, "reported_epoch": now}
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    with open(state_path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
PY
)

case "${liveness_changed}:${state}" in
  changed:failing)
    msg="🧠 Loreport health FAIL: ${failures[0]}"
    [ "${#failures[@]}" -gt 1 ] && msg="$msg (+$(( ${#failures[@]} - 1 )) more)"
    tg_notify "$msg"
    ;;
  changed:review)
    # Deliberately not "FAIL", and it says what still works. This is the line
    # that got misread; it now has to be read correctly.
    msg="🧠 Loreport OK — merge and publish are running; ${#reviews[@]} item(s) awaiting your review: ${reviews[0]}"
    tg_notify "$msg" --silent
    ;;
  recovered:*)
    # Only after a RECORDED failing/review state — never on a first run, where
    # there is nothing to have recovered from. Closing the loop matters: the
    # failure notice was pushed, so without this the reader never learns it
    # cleared and keeps treating the brain as broken.
    tg_notify "🧠 Loreport health recovered — all checks green" --silent
    ;;
esac

if [ "$state" = "failing" ]; then
  exit 1
fi

# Below here the pipeline is alive — `ok` and `review` both qualify. The
# heartbeat must NOT be gated on an empty review list: a quarantine count only
# falls when a human clears it, so one un-triaged block would otherwise silence
# the weekly "brain OK" ping forever and turn a review item into a liveness
# blackout — the exact failure this sprint exists to remove.
#
# 6 days, not 7, against a weekly timer. Two consecutive Monday 09:05 firings are
# exactly 7.00 days apart, so a 7-day threshold loses a slot to any manual run,
# Persistent= catch-up, or DST shift — and a silently-skipped heartbeat reads as
# "the brain died", which is the one false signal this check must never send.
last_hb=$(json_get "last_heartbeat_epoch")
if [ -z "$last_hb" ] || [ $((NOW - last_hb)) -ge $((6 * 86400)) ]; then
  mem_count=$(index_item_count)
  proj_date=$(python3 - "$MANIFEST" <<'PY' 2>/dev/null || echo "unknown"
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        print(json.load(fh).get("projected_at", "unknown"))
except Exception:
    print("unknown")
PY
)
  tg_notify "🧠 brain OK — ${mem_count} memories, projected ${proj_date}" --silent
  python3 - "$HEALTH_STATE" "$NOW" <<'PY'
import json, os, sys
state_path, now = sys.argv[1], int(sys.argv[2])
try:
    with open(state_path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError):
    data = {}
data["last_heartbeat_epoch"] = now
os.makedirs(os.path.dirname(state_path), exist_ok=True)
with open(state_path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
fi

exit 0
